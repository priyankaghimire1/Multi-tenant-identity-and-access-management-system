{
  "realm": "dat",
  "enabled": true,
  "displayName": "Multi-Tenant IAM Realm",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web App Public Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/dashboard.html",
        "http://localhost:3000/login.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "org_hint",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "org_hint",
            "claim.name": "org_hint",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "idp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "idp",
            "claim.name": "idp",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "acme-okta",
      "displayName": "Acme Okta",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "dat-federation",
        "clientSecret": "your-secret-value",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "http://localhost:8083/realms/acme-idp/protocol/openid-connect/auth",
        "logoutUrl": "http://localhost:8083/realms/acme-idp/protocol/openid-connect/logout",
        "tokenUrl": "http://acme-idp:8080/realms/acme-idp/protocol/openid-connect/token",
        "userInfoUrl": "http://acme-idp:8080/realms/acme-idp/protocol/openid-connect/userinfo",
        "jwksUrl": "http://acme-idp:8080/realms/acme-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "disableUserInfo": "true",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "acme-org-hint",
      "identityProviderAlias": "acme-okta",
      "identityProviderMapper": "hardcoded-user-session-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "org_hint",
        "attribute.value": "acme"
      }
    },
    {
      "name": "acme-idp-marker",
      "identityProviderAlias": "acme-okta",
      "identityProviderMapper": "hardcoded-user-session-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "idp",
        "attribute.value": "acme-okta"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Master Platform Administrator"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant Administrator"
      },
      {
        "name": "tenant-user",
        "description": "Standard Tenant Member"
      }
    ]
  },
  "users": [
    {
